{
  "expo": {
    "name": "RitzYard",
    "slug": "ritzyard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ritzyard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f5f2"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.yurekhsolutions.ritzyard",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/ritzlogo.png",
      "bundler": "metro",
      "name": "ritzyard - Where Value Meets Velocity",
      "shortName": "ritzyard",
      "description": "ritzyard - Premium B2B procurement platform connecting buyers with verified suppliers. Find quality products, request quotes, and streamline your supply chain with ritzyard.",
      "themeColor": "#c15738",
      "backgroundColor": "#faf8f6",
      "lang": "en",
      "orientation": "any",
      "display": "standalone",
      "meta": {
        "keywords": "ritzyard, B2B procurement, supplier portal, RFQ platform, bulk ordering, wholesale marketplace, business procurement, verified suppliers, quote requests, supply chain management",
        "author": "ritzyard",
        "viewport": "width=device-width, initial-scale=1, maximum-scale=5"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to upload company logos.",
          "cameraPermission": "The app needs access to your camera to take photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9362a786-3c52-4405-95ad-e28d410e0c50"
      }
    }
  }
}
